<!-- /.experience section — experience carousel -->
<div id="experience">
  <div class="container">

    <div id="experience-carousel" class="owl-carousel">

      <!-- Slide 1: SchoolHier -->
      <%= partial 'experiences/schoolhier' %>
      <!-- Slide 2: EZCall -->
      <%= partial 'experiences/ezcall' %>
      <!-- Slide 3: Placeholder BeImmunized -->
      <%= partial 'experiences/beimmunized' %>
      <!-- Slide 4: Placeholder AtlantProtocol-->
      <%= partial 'experiences/atlant_protocol' %>
      <!-- Slide 5: Placeholder Other Projects-->
      <%= partial 'experiences/other_projects' %>

    </div><!-- /#experience-carousel -->

    <!-- Custom icon navigation -->
    <div class="experience-nav">
      <button class="experience-nav-item active" data-slide="0">
        <img src="assets/experience-sh-logo.png" alt="SchoolHier">
      </button>
      <button class="experience-nav-item" data-slide="1">
        <img src="assets/experience-ezcall-logo.png" alt="EZCall">
      </button>
      <button class="experience-nav-item" data-slide="2">
        <img src="assets/experience-beimmunized-logo.png" alt="BeImmunized">
      </button>
      <button class="experience-nav-item" data-slide="3">
        <img src="assets/experience-ap-logo.png" alt="Atlant-Protocol">
      </button>
      <button class="experience-nav-item" data-slide="4">
        <img src="assets/experience-others.png" alt="Other Projects">
      </button>
    </div>

  </div>
</div>
