<!-- /.intro section — experience carousel -->
<div id="intro">
  <div class="container">

    <div id="experience-carousel" class="owl-carousel">

      <!-- Slide 1: SchoolHier -->
      <%= partial 'expiriences/schoolhier' %>
      <!-- Slide 2: EZCall -->
      <%= partial 'expiriences/ezcall' %>
      <!-- Slide 3: Placeholder BeImmunized -->
      <%= partial 'expiriences/beimmunized' %>
      <!-- Slide 4: Placeholder AtlantProtocol-->
      <%= partial 'expiriences/atlant_protocol' %>
      <!-- Slide 5: Placeholder Other Projects-->
      <%= partial 'expiriences/other_projects' %>

    </div><!-- /#experience-carousel -->

    <!-- Custom icon navigation -->
    <div class="experience-nav">
      <button class="experience-nav-item active" data-slide="0">
        <img src="assets/expirience-sh-logo.png" alt="SchoolHier">
      </button>
      <button class="experience-nav-item" data-slide="1">
        <img src="assets/expirience-ezcall-logo.png" alt="EZCall">
      </button>
      <button class="experience-nav-item" data-slide="2">
        <img src="assets/expirience-beimmunized-logo.png" alt="BeImmunized">
      </button>
      <button class="experience-nav-item" data-slide="3">
        <img src="assets/expirience-ap-logo.png" alt="Atlant-Protocol">
      </button>
      <button class="experience-nav-item" data-slide="4">
        <img src="assets/expirience-others.png" alt="Other Projects">
      </button>
    </div>

  </div>
</div>
